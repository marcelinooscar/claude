# =============================================
# CONFIGURACIÓN GENERAL
# =============================================
PORT=3000
SESSION_SECRET=cambia-este-secreto-muy-largo-y-aleatorio
TIMEZONE=Europe/Madrid

# =============================================
# CREDENCIALES DE ACCESO
# =============================================
# Acceso compartido para clientes
CLIENT_USERNAME=cliente
CLIENT_PASSWORD=reserva2024

# Acceso administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin2024

# =============================================
# GOOGLE CALENDAR API (Cuenta de Servicio)
# =============================================
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un proyecto y habilita la API de Google Calendar
# 3. Crea una cuenta de servicio y descarga el JSON de credenciales
# 4. Comparte tu calendario de Google con el email de la cuenta de servicio
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta@tu-proyecto.iam.gserviceaccount.com
# Copia la private_key del JSON (con los \n literales)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
# ID del calendario (puede ser tu email de Gmail o el ID del calendario)
GOOGLE_CALENDAR_ID=tu-email@gmail.com

# =============================================
# NOTIFICACIONES POR EMAIL (Webhook)
# =============================================
EMAIL_WEBHOOK_URL=https://tu-webhook-de-email.com/send
ADMIN_EMAIL=admin@tucentro.com

# =============================================
# INFORMACIÓN DEL CENTRO
# =============================================
CENTER_NAME=Centro de Estética
CENTER_PHONE=+34600000000

# =============================================
# WHATSAPP (configurado pero inactivo en v1)
# =============================================
WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_URL=
WHATSAPP_FROM=
